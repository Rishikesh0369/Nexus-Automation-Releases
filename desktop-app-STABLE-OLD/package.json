{
  "name": "nexus-automation",
  "version": "1.1.0",
  "description": "Nexus Automation - Cash Memo Auto-Cancellation Desktop Application",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "obfuscate": "node obfuscate.js",
    "obfuscate:all": "node obfuscate.js --all",
    "obfuscate:restore": "node obfuscate.js --restore",
    "dist": "electron-builder",
    "build": "electron-builder",
    "release": "electron-builder --publish always"
  },
  "keywords": [
    "electron",
    "bpcl",
    "automation",
    "playwright"
  ],
  "author": "Nexus Automation",
  "license": "ISC",
  "dependencies": {
    "@antiadmin/anticaptchaofficial": "^1.0.56",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.3.0",
    "playwright": "^1.50.0"
  },
  "devDependencies": {
    "dotenv-cli": "^11.0.0",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "javascript-obfuscator": "^5.7.0"
  },
  "build": {
    "appId": "com.nexus.automation",
    "productName": "Nexus Automation",
    "directories": {
      "output": "release"
    },
    "extraResources": [
      {
        "from": "assets",
        "to": "assets"
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "Rishikesh0369",
      "repo": "bharat-gas-nexus-releases"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico",
      "artifactName": "Nexus-Automation-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Nexus-Automation-Setup-${version}.${ext}"
    }
  }
}
