{
  "name": "nexus-automation",
  "version": "1.1.7",
  "description": "Nexus Automation - Cash Memo Auto-Cancellation Desktop Application",
  "main": "main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/Rishikesh0369/Nexus-Automation-Releases.git"
  },
  "scripts": {
    "start": "electron .",
    "obfuscate": "node obfuscate.js",
    "obfuscate:all": "node obfuscate.js --all",
    "obfuscate:restore": "node obfuscate.js --restore",
    "obfuscate:protected": "node build_protected.js",
    "dist:win": "node build_protected.js && electron-builder --win --x64 --config electron-builder.protected.json",
    "build:local": "node archive_build.js && node obfuscate.js && electron-builder --win",
    "dist": "node archive_build.js && node obfuscate.js && electron-builder",
    "build": "node archive_build.js && node obfuscate.js && electron-builder",
    "release": "node archive_build.js && node obfuscate.js && electron-builder --publish always"
  },
  "keywords": [
    "electron",
    "bpcl",
    "automation",
    "playwright"
  ],
  "author": "Nexus Automation",
  "license": "ISC",
  "dependencies": {
    "@antiadmin/anticaptchaofficial": "^1.0.56",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.3.0",
    "exceljs": "^4.4.0",
    "playwright": "^1.50.0"
  },
  "devDependencies": {
    "dotenv-cli": "^11.0.0",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "javascript-obfuscator": "^5.7.0"
  },
  "build": {
    "appId": "com.nexus.automation",
    "productName": "Nexus Automation",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "bela_nexus_runner.js",
      "scrapers/**/*",
      "index.html",
      "toast.html",
      "styles.css",
      "package.json",
      "assets/**/*",
      "!**/*.bak",
      "!**/*.log",
      "!nexus_logs/**/*",
      "!.env*",
      "!electron-builder.env*",
      "!test_*",
      "!obfuscate.js",
      "!archive_build.js",
      "!automationRunner.js",
      "!eng.traineddata"
    ],
    "extraResources": [
      {
        "from": "assets",
        "to": "assets"
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "Rishikesh0369",
      "repo": "Nexus-Automation-Releases"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico",
      "artifactName": "Nexus-Automation-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "artifactName": "Nexus-Automation-Setup-${version}.${ext}"
    }
  }
}
